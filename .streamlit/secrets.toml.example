# Paste these (with your real key) into Streamlit Cloud: App settings > Secrets. Never commit the real values.
LLM_PROVIDER = "anthropic"
LLM_MODEL = "claude-haiku-5-5"
ANTHROPIC_API_KEY = "sk-ant-..."
GUARDRAILS = "on"          # set to "off" if the app runs out of memory on the free tier
MAX_USER_MESSAGES = "30"
LLM_TIMEOUT_S = "60"
