ANTHROPIC_API_KEY=
LLM_PROVIDER=vertex
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-haiku-5-5
GOOGLE_CLOUD_PROJECT=indigo-medium-504811-u7
GOOGLE_CLOUD_LOCATION=global
GUARDRAILS=on
RETRIEVAL_MODE=vector        # bm25 | vector | hybrid (falls back to bm25 if Vertex or Qdrant is unavailable)
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_LOCATION=us-central1
# Qdrant Cloud or server. Use the :443 port (6333 is blocked on some networks). Unset = local on-disk store in data/qdrant_local.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=haq_corpus
